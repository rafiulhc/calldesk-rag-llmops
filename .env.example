# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Your API's own key that clients send in the X-API-Key header. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=change-me

# Local Postgres from docker-compose.yml (inside Docker, compose overrides this to use host "db")
DATABASE_URL=postgresql://llmops:llmops@localhost:5432/llmops

# Optional: LangSmith tracing (https://smith.langchain.com)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=calldesk-llmops
